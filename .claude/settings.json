{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CARGO_TERM_COLOR": "always",
    "CUDA_COMPUTE_CAP": "86"
  },
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo deny:*)",
      "Bash(rustc --version)",
      "Bash(rustup show:*)",
      "Bash(./scripts/check-device-construction.sh)",
      "Bash(./scripts/check-format-version.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(just setup-frontend)",
      "Bash(cargo update:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(just clean-data)",
      "Bash(cargo publish:*)",
      "Read(./data/**)",
      "Read(./models/**)",
      "Read(./target/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/invariant-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
